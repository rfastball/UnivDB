# =============================================================================
# UnivCore package manifest
# CodeManager가 Core 배포 패키지(Pkg_ExportCorePackage)를 만들 때 읽는 선언 파일.
# 이 파일은 항상 <project>\src\core.manifest 에 둔다. (편집 본가 = UnivCore.xlsb)
#
# [작성 규약]
#  - '#'으로 시작하는 줄과 빈 줄은 무시된다.
#  - 각 줄은  key: value  형식. value의 앞뒤 공백은 제거된다.
#  - include : 패키지에 넣을 모듈 '접두사'.  'Core_*' 와 'Core_' 는 동일하게 접두사로 해석.
#              여러 개면 쉼표로 구분하거나, include 줄을 여러 번 써도 된다.
#  - exclude : include에 걸리지만 빼고 싶은 항목.
#              정확한 모듈명(예: Core_modSelfTest) 또는 끝에 '*'를 붙인 접두사(예: Core_modTest_*).
#  - types   : 포함할 확장자. bas, cls, frm 중. 생략 시 기본값 = bas, cls.
#  - 모듈명 비교는 대소문자를 구분하지 않는다.
#
#  ※ 문서 모듈(ThisWorkbook / 시트, VBComponent.Type=100)은 위 규칙과 무관하게
#    '항상' 제외된다. (받는 프로젝트의 ThisWorkbook/시트 코드를 덮어쓰는 사고 차단)
#
#  ※ 이 .manifest 자체와 .bas/.cls 가 아닌 파일은 패키지에 들어가지 않는다.
# =============================================================================

format: 1
package: UnivCore

# --- 무엇을 Core로 볼 것인가 (접두사) ---
include: Core_*

# --- include엔 걸리지만 배포에서 뺄 것 (자체 테스트/벤치 등) ---
# 정확명:  exclude: Core_modSelfTest, Core_modBench
# 접두사:  exclude: Core_modTest_*
exclude: Core_modSelfTest, Core_modBench

# --- 포함 확장자 (생략 시 bas, cls) ---
types: bas, cls
